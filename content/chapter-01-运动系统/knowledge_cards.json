  {
    "id": "bone-004",
    "front": "长骨的特征是什么？分布于何处？",
    "back": "呈长管状，分为一体两端；体内有空腔称髓腔，两端膨大称骺。分布于四肢",
    "tags": [
      "长骨",
      "形态"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-005",
    "front": "骺软骨是什么？成年后变成什么？",
    "back": "幼年时骨干与骺之间保留的透明软骨，骺软骨细胞不断增殖和骨化使骨加长。成年后骨化，遗留骺线",
    "tags": [
      "骺软骨",
      "骺线",
      "长骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-006",
    "front": "短骨分布于何处？举例",
    "back": "多成群分布于连结牢固且运动较灵活的部位，如腕骨和跗骨",
    "tags": [
      "短骨",
      "腕骨",
      "跗骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-007",
    "front": "扁骨的特征和功能是什么？举例",
    "back": "呈板状，参与构成颅腔、胸腔和盆腔壁，保护脏器。如颅盖骨和肋骨",
    "tags": [
      "扁骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-008",
    "front": "什么是不规则骨？含气骨举例",
    "back": "形状不规则的骨，如椎骨。有些不规则骨内有与外界相通的腔洞，称含气骨，如上颌骨",
    "tags": [
      "不规则骨",
      "含气骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-009",
    "front": "籽骨是什么？人体最大的籽骨是哪块？",
    "back": "位于肌腱内的扁圆形小骨，减少摩擦和改变肌肉牵拉方向。髌骨是人体最大的籽骨",
    "tags": [
      "籽骨",
      "髌骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-010",
    "front": "骨由哪三部分构成？",
    "back": "骨质、骨膜和骨髓",
    "tags": [
      "骨",
      "构造"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-011",
    "front": "骨密质和骨松质有何区别？",
    "back": "骨密质结构致密，抗压抗扭曲性强，分布于骨表面。骨松质呈海绵状，由骨小梁交织排列，分布于骨内部",
    "tags": [
      "骨质",
      "骨密质",
      "骨松质"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-012",
    "front": "什么是板障？位于何处？",
    "back": "扁骨的骨松质配布于内、外板之间，称板障，有板障静脉经过。颅盖骨骨折多见于内板",
    "tags": [
      "板障",
      "扁骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-013",
    "front": "骨膜有什么功能？分几层？",
    "back": "含丰富神经血管和淋巴管，对骨的营养、再生和感觉有重要作用。分内、外两层，内层有成骨和破骨能力",
    "tags": [
      "骨膜"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-014",
    "front": "红骨髓和黄骨髓有何区别？",
    "back": "红骨髓有造血和免疫功能，胎儿和幼儿均为红骨髓。5岁后长骨骨干红骨髓被脂肪代替称黄骨髓。椎骨、髂骨、肋骨、胸骨及长骨骺内终身存在红骨髓",
    "tags": [
      "骨髓",
      "红骨髓",
      "黄骨髓"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-015",
    "front": "临床常选何处进行骨髓穿刺？",
    "back": "髂前上棘或髂后上棘等处",
    "tags": [
      "骨髓穿刺",
      "髂骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-016",
    "front": "幼儿和老年人骨折有何不同？",
    "back": "幼儿有机质和无机质各占一半，弹性大，易发生青枝骨折。老年人无机质比例大，骨质疏松，脆性大，易骨折",
    "tags": [
      "骨折",
      "年龄差异"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "骨的概述"
  },
  {
    "id": "bone-017",
    "front": "躯干骨包括哪些骨？",
    "back": "24块椎骨、1块骶骨、1块尾骨、1块胸骨和12对肋骨",
    "tags": [
      "躯干骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-018",
    "front": "椎骨由哪两部分组成？椎孔和椎管是什么？",
    "back": "由前方椎体和后方椎弓组成。椎体后面与椎弓围成椎孔，各椎孔贯通构成椎管，容纳脊髓",
    "tags": [
      "椎骨",
      "椎孔",
      "椎管"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-019",
    "front": "椎间孔如何形成？通行什么？",
    "back": "相邻椎骨的椎上、下切迹共同围成，有脊神经和血管通过",
    "tags": [
      "椎间孔",
      "脊神经"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-020",
    "front": "椎弓发出哪7个突起？",
    "back": "棘突1个（向后或后下）、横突1对（向两侧）、上关节突1对、下关节突1对",
    "tags": [
      "椎骨",
      "突起"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-021",
    "front": "胸椎的主要特征？",
    "back": "椎体侧面有上下肋凹（接肋头），横突末端有横突肋凹（接肋结节），棘突长而向后下倾斜呈叠瓦状排列，关节突关节面呈冠状位",
    "tags": [
      "胸椎",
      "肋凹"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-022",
    "front": "颈椎的特征是什么？",
    "back": "椎体较小，横断面椭圆形。横突有横突孔（通行椎动脉和椎静脉），椎孔大呈三角形，第2~6颈椎棘突短而分叉",
    "tags": [
      "颈椎",
      "横突孔"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-023",
    "front": "横突孔中通行什么结构？",
    "back": "椎动脉和椎静脉（椎动脉向上穿第6至第1颈椎横突孔）",
    "tags": [
      "横突孔",
      "椎动脉"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-024",
    "front": "钩椎关节（Luschka关节）是什么？临床意义？",
    "back": "第3~7颈椎椎体钩与上位椎体唇缘相接形成。过度增生可致椎间孔狭窄，压迫脊神经",
    "tags": [
      "钩椎关节",
      "颈椎"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-025",
    "front": "第1颈椎（寰椎）有何特征？",
    "back": "呈环状，无椎体、棘突和关节突，由前弓、后弓及侧块组成。前弓后面有齿突凹与枢椎齿突相关节",
    "tags": [
      "寰椎",
      "第1颈椎"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-026",
    "front": "第2颈椎（枢椎）有何特征？",
    "back": "椎体向上伸出齿突，与寰椎齿突凹相关节",
    "tags": [
      "枢椎",
      "第2颈椎",
      "齿突"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-027",
    "front": "第7颈椎（隆椎）有何特征？",
    "back": "棘突长，末端不分叉，活体易于触及，常作为计数椎骨的标志",
    "tags": [
      "隆椎",
      "第7颈椎"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-028",
    "front": "腰椎的主要特征？",
    "back": "椎体粗壮，横断面肾形。棘突宽短呈板状，水平伸向后方。各棘突间隙较宽，可用于腰椎穿刺",
    "tags": [
      "腰椎",
      "腰椎穿刺"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-029",
    "front": "骶骨由几块骶椎融合？岬位于何处？",
    "back": "由5块骶椎融合，呈三角形。上缘中份向前隆凸称岬",
    "tags": [
      "骶骨",
      "岬"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-030",
    "front": "骶管裂孔和骶角的临床意义？",
    "back": "骶管裂孔是骶管下端开口，裂孔两侧有骶角。骶管麻醉常以骶角作为标志",
    "tags": [
      "骶管裂孔",
      "骶角"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-031",
    "front": "骶前孔和骶后孔各有几对？通行什么？",
    "back": "各有4对。骶前、后孔分别有骶神经前、后支通过，均与骶管相通",
    "tags": [
      "骶前孔",
      "骶后孔"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-椎骨"
  },
  {
    "id": "bone-032",
    "front": "胸骨分哪三部分？",
    "back": "胸骨柄、胸骨体和剑突",
    "tags": [
      "胸骨"
    ],
    "type": "knowledge",
    "system": "运动系统",
    "section": "骨学",
    "subsection": "躯干骨-胸骨和肋"
  },
  {
    "id": "bone-033",
    "front": "胸骨角的临床意义？",
    "back": "胸骨柄与体连接处，两侧平对第2肋（计数肋标志），向后平对第4胸椎下缘",
