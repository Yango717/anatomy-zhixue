  {"id":"atlas-resp-004","image":"图3-16 气管和支气管","page":125,"title":"气管和主支气管","structures":[{"label":"气管","desc":"C形软骨环，14~17个"},{"label":"气管杈","desc":"平胸骨角（T4~T5）"},{"label":"气管隆嵴","desc":"气管杈内面向上凸起的纵嵴"},{"label":"右主支气管","desc":"短（~2cm）、粗、陡直，异物易入"},{"label":"左主支气管","desc":"长（~5cm）、细、水平"}],"tags":["气管","气管杈","隆嵴","主支气管"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"气管"},
  {"id":"atlas-resp-005","image":"图3-18/3-19 肺的外形","page":126,"title":"肺的形态（前面和纵隔面）","structures":[{"label":"肺尖","desc":"高出锁骨内侧1/3上方2~3cm"},{"label":"肺底","desc":"坐于膈上"},{"label":"肋面","desc":"凸向胸壁"},{"label":"纵隔面","desc":"中央为肺门"},{"label":"肺门","desc":"主支气管、血管出入处"},{"label":"斜裂","desc":"分隔肺叶（左肺上、下叶；右肺上、中与下叶）"},{"label":"水平裂","desc":"仅右肺有，分上叶和中叶"},{"label":"心切迹","desc":"左肺前缘，心脏占据处"}],"tags":["肺","肺门","斜裂","水平裂","心切迹"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"肺"},
  {"id":"atlas-resp-006","image":"图3-20 支气管树","page":127,"title":"支气管树和肺段","structures":[{"label":"叶支气管","desc":"右3支，左2支"},{"label":"段支气管","desc":"共23~25级分支"},{"label":"支气管肺段","desc":"段支气管所属的锥形肺组织，右10段左8段"}],"tags":["支气管树","肺段","段支气管"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"肺"},
  {"id":"atlas-resp-007","image":"图3-22 胸膜","page":130,"title":"胸膜和胸膜隐窝","structures":[{"label":"脏胸膜","desc":"紧贴肺表面"},{"label":"壁胸膜","desc":"衬于胸壁内面，分四部"},{"label":"胸膜顶","desc":"高出锁骨内侧1/3上方2.5cm"},{"label":"肋膈隐窝","desc":"肋胸膜与膈胸膜转折处，胸膜腔最低点"},{"label":"胸膜腔","desc":"脏、壁胸膜间潜在间隙，负压"}],"tags":["胸膜","肋膈隐窝","胸膜顶","胸膜腔"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"胸膜"},
