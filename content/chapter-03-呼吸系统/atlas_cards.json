  {"id":"atlas-resp-001","image":"图3-2 鼻腔外侧壁","page":117,"title":"鼻腔外侧壁的结构","structures":[{"label":"上鼻甲","desc":"位于鼻腔外侧壁最上方"},{"label":"中鼻甲","desc":"筛窦开口于其下方"},{"label":"下鼻甲","desc":"最大的鼻甲"},{"label":"半月裂孔","desc":"中鼻道内的弧形裂隙，额窦和上颌窦开口于此"},{"label":"筛泡","desc":"中鼻道内的圆形隆起"},{"label":"蝶筛隐窝","desc":"上鼻甲后上方凹陷，蝶窦开口于此"}],"tags":["鼻腔","鼻甲","半月裂孔","筛泡"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"鼻腔"},
  {"id":"atlas-resp-002","image":"图3-5 喉软骨","page":119,"title":"喉软骨（前面观）","structures":[{"label":"甲状软骨","desc":"最大喉软骨，前角上端为喉结"},{"label":"环状软骨","desc":"唯一完整环形软骨，平C6"},{"label":"会厌软骨","desc":"叶状弹性软骨，吞咽时盖住喉口"},{"label":"杓状软骨","desc":"成对，有肌突和声带突"}],"tags":["喉","软骨","甲状软骨","环状软骨"],"type":"atlas","system":"呼吸系统","section":"呼吸系统","subsection":"喉"},
